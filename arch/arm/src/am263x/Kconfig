comment "AM263x Configuration Options"

choice
	prompt "AM263x chip"
	default ARCH_CHIP_AM2634

config ARCH_CHIP_AM2631
	bool "AM2631 (1x Cortex-R5F)"

config ARCH_CHIP_AM2632
	bool "AM2632 (2x Cortex-R5F)"

config ARCH_CHIP_AM2634
	bool "AM2634 (4x Cortex-R5F)"

endchoice # AM263x chip

menu "AM263x Peripheral Selection"

config AM263X_PRU
	bool "ICSSM PRU cores"
	default n
	---help---
		Character drivers for the two PRU cores of ICSSM0 (/dev/pru0,
		/dev/pru1): load firmware into a core's IRAM and DMEM, start and
		stop it, and read and write its DMEM.  See
		arch/arm/include/am263x/pru.h.

config AM263X_MCSPI
	bool
	default n

config AM263X_MCSPI0
	bool "MCSPI0"
	default n
	depends on SPI
	select AM263X_MCSPI

config AM263X_MCSPI1
	bool "MCSPI1"
	default n
	depends on SPI
	select AM263X_MCSPI

config AM263X_MCSPI2
	bool "MCSPI2"
	default n
	depends on SPI
	select AM263X_MCSPI

config AM263X_MCSPI3
	bool "MCSPI3"
	default n
	depends on SPI
	select AM263X_MCSPI

config AM263X_MCSPI4
	bool "MCSPI4"
	default n
	depends on SPI
	select AM263X_MCSPI

config AM263X_I2C
	bool
	default n
	select I2C
	select ARCH_HAVE_I2CRESET

config AM263X_I2C0
	bool "I2C0"
	default n
	select AM263X_I2C

config AM263X_I2C1
	bool "I2C1"
	default n
	select AM263X_I2C

config AM263X_I2C2
	bool "I2C2"
	default n
	select AM263X_I2C

config AM263X_I2C3
	bool "I2C3"
	default n
	select AM263X_I2C

config AM263X_CPSW
	bool
	default n

config AM263X_MDIO
	bool "CPSW MDIO controller"
	default n
	depends on NET
	select AM263X_CPSW
	select NETDEVICES
	select MDIO_BUS
	---help---
		The CPSW's MDIO controller as an MDIO bus lower half
		(am263x_mdio_initialize()), for managing the Ethernet PHYs.

config AM263X_CPSW_ETH
	bool "CPSW Ethernet"
	default n
	depends on NET
	select AM263X_MDIO
	select NET_PHYLIB
	select MM_IOB
	select ARCH_HAVE_NETDEV_STATISTICS
	---help---
		Ethernet through one MAC port of the CPSW3G, as eth0.  The
		switch is bypassed: the other MAC port is disabled.  The board
		registers the PHY driver (PHYLIB).  The MAC address is the one
		in the device's eFuse, unless the board sets another
		(am263x_cpsw_setmacaddr()).

config AM263X_CONTROLSS
	bool
	default n

config AM263X_ADC
	bool
	default n
	select AM263X_CONTROLSS

config AM263X_ADC0
	bool "ADC0"
	default n
	depends on ADC
	select AM263X_ADC

config AM263X_ADC1
	bool "ADC1"
	default n
	depends on ADC
	select AM263X_ADC

config AM263X_ADC2
	bool "ADC2"
	default n
	depends on ADC
	select AM263X_ADC

config AM263X_ADC3
	bool "ADC3"
	default n
	depends on ADC
	select AM263X_ADC

config AM263X_ADC4
	bool "ADC4"
	default n
	depends on ADC
	select AM263X_ADC

config AM263X_EPWM
	bool "ePWM"
	default n
	depends on PWM
	select AM263X_CONTROLSS
	---help---
		The ePWMs (EPWM0-31) as PWM lower halves
		(am263x_pwminitialize()): output A is channel 1, output B
		channel 2.  Each can also start ADC conversions through its
		SOCA and SOCB (am263x_pwm_socconfig()).

config AM263X_MCAN
	bool
	default n
	select NET_CAN_HAVE_CANFD
	select NET_CAN_HAVE_ERRORS
	select MM_IOB

config AM263X_MCAN0
	bool "MCAN0"
	default n
	depends on NET_CAN
	select AM263X_MCAN

config AM263X_MCAN1
	bool "MCAN1"
	default n
	depends on NET_CAN
	select AM263X_MCAN

config AM263X_MCAN2
	bool "MCAN2"
	default n
	depends on NET_CAN
	select AM263X_MCAN

config AM263X_MCAN3
	bool "MCAN3"
	default n
	depends on NET_CAN
	select AM263X_MCAN

endmenu # AM263x Peripheral Selection

menu "AM263x ADC Configuration"
	depends on AM263X_ADC

config AM263X_ADC_PRESCALE
	int "ADC clock prescaler (ADCCTL2.PRESCALE)"
	default 6
	range 0 15
	---help---
		ADCCLK = SYSCLK (200 MHz) / divider.  0 is /1, 1 is invalid,
		and n >= 2 is /((n + 2) / 2): 2 is /2, 3 is /2.5, 6 is /4
		(50 MHz), 14 is /8.  Keep ADCCLK within the datasheet maximum.

config AM263X_ADC_SAMPLE_WINDOW
	int "Sample window (SYSCLK cycles)"
	default 32
	range 1 512
	---help---
		How long each SOC samples its input, in 5 ns SYSCLK cycles.  At
		least one ADCCLK cycle and the datasheet minimum; longer for
		high-impedance sources.

config AM263X_ADC_EXTERNAL_REF
	bool "External reference"
	default n
	---help---
		The board drives VREFHI.  Without this the driver turns on the
		internal reference buffer of each enabled ADC's group (ADC0,
		ADC1/2, ADC3/4), as TI's SDK does by default.

config AM263X_ADC_INTXBAR
	int "First INTXBAR output"
	default 0
	range 0 27
	---help---
		ADCn's ADCINT1 reaches the CPU through CONTROLSS INTXBAR output
		AM263X_ADC_INTXBAR + n (R5F interrupt 146 + that).

endmenu # AM263x ADC Configuration

menu "AM263x MCAN Configuration"
	depends on AM263X_MCAN

config AM263X_MCAN_BITRATE
	int "Nominal bit rate"
	default 500000
	---help---
		Arbitration-phase (and classic CAN) bit rate in bit/s, the same
		for every port until SIOCSCANBITRATE changes it.  The 80 MHz
		clock must divide into a whole number of 5-385 time quanta per
		bit.

config AM263X_MCAN_SAMPLEP
	int "Nominal sample point (percent)"
	default 80
	range 50 95

config AM263X_MCAN_DATA_BITRATE
	int "CAN FD data bit rate"
	default 2000000
	depends on NET_CAN_CANFD
	---help---
		Data-phase bit rate in bit/s, used by CAN FD frames sent with
		CANFD_BRS.  Transmitter delay compensation is on above 1 Mbit/s.

config AM263X_MCAN_DATA_SAMPLEP
	int "CAN FD data sample point (percent)"
	default 75
	range 50 95
	depends on NET_CAN_CANFD

config AM263X_MCAN_BUSERR
	bool "Report bus errors"
	default n
	depends on NET_CAN_ERRORS
	---help---
		Also send an error frame for each protocol error (stuff, form,
		ACK, bit, CRC).  Without a bus partner every frame sent gives one.

config AM263X_MCAN_LOOPBACK
	bool "Internal loopback"
	default n
	---help---
		Run every MCAN in internal loopback (TEST.LBCK with bus
		monitoring): frames sent are received back and the TX pins stay
		recessive.  For testing without a bus.

endmenu # AM263x MCAN Configuration

menu "AM263x I2C Configuration"
	depends on AM263X_I2C

config AM263X_I2C_TIMEOUT_MS
	int "I2C transfer timeout slack (ms)"
	default 20
	---help---
		Added to four times the nominal duration of every transfer
		segment before it is abandoned and the module reset.  Also
		bounds how long a transfer waits for the bus to go idle.

config AM263X_I2C_LOOPBACK
	bool "I2C digital loopback (self-test)"
	default n
	---help---
		Provide am263x_i2c_loopback(): the module addresses itself
		(I2CMDR.DLB), so master-transmit transfers complete and the
		bytes come back through the receive register with nothing on
		the bus.  For a board self-test.

endmenu # AM263x I2C Configuration

menu "AM263x MDIO Configuration"
	depends on AM263X_MDIO

config AM263X_MDIO_FREQUENCY
	int "MDC frequency (Hz)"
	default 2200000
	---help---
		The MDIO bus clock, divided down from the 200 MHz CPSW clock.
		IEEE 802.3 allows up to 2.5 MHz; many PHYs, the DP83869
		among them, accept more.

endmenu # AM263x MDIO Configuration

menu "AM263x CPSW Ethernet Configuration"
	depends on AM263X_CPSW_ETH

config AM263X_CPSW_ETH_PORT
	int "MAC port"
	default 1
	range 1 2
	---help---
		The CPSW MAC port the interface uses.  On the LP-AM263 port 1
		(RGMII1) goes to J7.

config AM263X_CPSW_ETH_PHYADDR
	int "PHY MDIO address"
	default 3
	range 0 31

config AM263X_CPSW_ETH_RGMII_INTERNAL_DELAY
	bool "SoC adds the RGMII delays"
	default y
	---help---
		Leave the SoC's internal RGMII clock delays on (CPSW_CONTROL
		RGMIIn_ID_MODE = 0), as TI's SDK does for the LP-AM263.

choice
	prompt "RGMII delays the PHY adds"
	default AM263X_CPSW_ETH_PHY_RGMII_ID
	---help---
		The PHY interface mode PHYLIB passes to the PHY driver.  The
		LP-AM263, as TI's SDK sets it up, has the DP83869 shift both
		clocks (and CONFIG_NET_PHY_TI_DP83869_TX/RX_DELAY_PS = 500).

config AM263X_CPSW_ETH_PHY_RGMII
	bool "None (RGMII)"

config AM263X_CPSW_ETH_PHY_RGMII_ID
	bool "TX and RX (RGMII_ID)"

config AM263X_CPSW_ETH_PHY_RGMII_TXID
	bool "TX only (RGMII_TXID)"

config AM263X_CPSW_ETH_PHY_RGMII_RXID
	bool "RX only (RGMII_RXID)"

endchoice

config AM263X_CPSW_ETH_NRXDESC
	int "RX descriptors"
	default 32
	---help---
		Each has a 1536-byte buffer.

config AM263X_CPSW_ETH_NTXDESC
	int "TX descriptors"
	default 16
	---help---
		Each has a 1536-byte buffer.  The driver holds at most one
		packet fewer than this (its TX quota).

endmenu # AM263x CPSW Ethernet Configuration

menu "AM263x MCSPI Configuration"
	depends on AM263X_MCSPI

config AM263X_MCSPI_LOOPBACK
	bool "Loop D0 back to the receiver"
	default n
	---help---
		Receive on D0, the pin the controller transmits on, instead of
		D1, so every word sent comes back through the D0 pad.  For
		testing a bus without wiring or a device.  The D0 pad must have
		its input enabled.

endmenu # AM263x MCSPI Configuration
