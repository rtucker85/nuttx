include armv7-r/Make.defs

CHIP_CSRCS  = am263x_boot.c am263x_clockconfig.c am263x_gpio.c
CHIP_CSRCS += am263x_irq.c
CHIP_CSRCS += am263x_mpuinit.c am263x_pinmux.c am263x_serial.c
CHIP_CSRCS += am263x_systemreset.c am263x_timer.c

ifeq ($(CONFIG_AM263X_PRU),y)
CHIP_CSRCS += am263x_pru.c
endif

ifeq ($(CONFIG_AM263X_I2C),y)
CHIP_CSRCS += am263x_i2c.c
endif

ifeq ($(CONFIG_AM263X_MCSPI),y)
CHIP_CSRCS += am263x_spi.c
endif

ifeq ($(CONFIG_AM263X_QSPI),y)
CHIP_CSRCS += am263x_qspi.c
endif

ifeq ($(CONFIG_AM263X_MDIO),y)
CHIP_CSRCS += am263x_mdio.c
endif

ifeq ($(CONFIG_AM263X_CPSW),y)
CHIP_CSRCS += am263x_cpsw.c
endif

ifeq ($(CONFIG_AM263X_CONTROLSS),y)
CHIP_CSRCS += am263x_controlss.c
endif

ifeq ($(CONFIG_AM263X_ADC),y)
CHIP_CSRCS += am263x_adc.c
endif

ifeq ($(CONFIG_AM263X_EPWM),y)
CHIP_CSRCS += am263x_pwm.c
endif

ifeq ($(CONFIG_AM263X_MCAN),y)
CHIP_CSRCS += am263x_mcan.c
endif

ifeq ($(CONFIG_AM263X_TSENSE),y)
CHIP_CSRCS += am263x_tsense.c
endif

ifeq ($(CONFIG_AM263X_LIN),y)
CHIP_CSRCS += am263x_lin.c
endif
