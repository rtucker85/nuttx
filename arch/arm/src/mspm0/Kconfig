comment "TI MSPM0 configuration"

choice
	prompt "TI MSPM0 Chip Selection"
	default ARCH_CHIP_MSPM0G3519

config ARCH_CHIP_MSPM0G3519
	bool "MSPM0G3519"
	select ARCH_CHIP_MSPM0G351X
	---help---
		TI MSPM0G3519 (Cortex-M0+, 80 MHz, CAN FD).

endchoice # TI MSPM0 Chip Selection

config ARCH_CHIP_MSPM0G351X
	bool
	default n
