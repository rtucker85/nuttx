menuconfig MOTOR
	bool "Motor control drivers"
	default n

if MOTOR

config MOTOR_UPPER
	bool "Motor generic upper-half driver"
	default n
	---help---
		Enables building of a motor generic upper half driver.

if MOTOR_UPPER

config MOTOR_UPPER_HAVE_POSITION
	bool "Have position control"
	default n

config MOTOR_UPPER_HAVE_DIRECTION
	bool "Have direction control"
	default n

config MOTOR_UPPER_HAVE_SPEED
	bool "Have speed control"
	default n

config MOTOR_UPPER_HAVE_TORQUE
	bool "Have torque control (rotary motors)"
	default n

config MOTOR_UPPER_HAVE_FORCE
	bool "Have force control (linear motors)"
	default n

config MOTOR_UPPER_HAVE_ACCELERATION
	bool "Have acceleration control"
	default n

config MOTOR_UPPER_HAVE_DECELERATION
	bool "Have deceleration control"
	default n

config MOTOR_UPPER_HAVE_INPUT_VOLTAGE
	bool "Have input voltage protection"
	default n

config MOTOR_UPPER_HAVE_INPUT_CURRENT
	bool "Have input current protection"
	default n

config MOTOR_UPPER_HAVE_INPUT_POWER
	bool "Have input power protection"
	default n

endif

config MOTOR_DRV8145
	bool "TI DRV8145-Q1 half-bridge drivers (SPI daisy chain)"
	default n
	depends on SPI
	---help---
		A daisy chain of TI DRV8145-Q1 half-bridge drivers (or the
		DRV8143 and DRV8144, which share its register map) on one SPI
		chip select, as /dev/hbN: configuration, output control through
		SPI_IN and the board's IN and DRVOFF pins, status and fault
		clearing, off-state diagnostics, and set-up again after a
		power-on reset.

if MOTOR_DRV8145

config MOTOR_DRV8145_FREQUENCY
	int "SPI frequency (Hz)"
	default 5000000
	range 100000 10000000
	---help---
		SCLK for the chain; the device allows up to 10 MHz.

config MOTOR_DRV8145_OLP_SETTLE_US
	int "Off-state diagnostics settling time (us)"
	default 1000
	range 10 100000
	---help---
		How long the output is left to settle with each OLP pull-up or
		pull-down before the comparator is read.  The internal resistors
		are 1 kohm, so this depends mostly on the capacitance on the
		output.

menu "Default configuration"

comment "Used when the board gives no CONFIG1-4; changeable at run time"

config MOTOR_DRV8145_SR
	int "Slew rate (S_SR, 0-7)"
	default 0
	range 0 7
	---help---
		Output rise time, typical with high-side recirculation at 13.5 V:
		0 1.5, 1 4.7, 2 9.6, 3 14.4, 4 20.6, 5 26.5, 6 37.9, 7 47.1 V/us.
		Slower is quieter (EMI), faster switches with less loss.

config MOTOR_DRV8145_ITRIP
	int "ITRIP current regulation (S_ITRIP, 0-7)"
	default 0
	range 0 7
	---help---
		The IPROPI voltage at which the bridge regulates the current: 0
		off, 1 1.18, 2 1.41, 3 1.65, 4 1.98, 5 2.31, 6 2.64, 7 2.97 V.

config MOTOR_DRV8145_TOFF
	int "ITRIP off time (TOFF, 0-3)"
	default 1
	range 0 3
	---help---
		0 20, 1 30, 2 40, 3 50 us.

config MOTOR_DRV8145_OCP
	int "Overcurrent threshold (OCP_SEL, 0-2)"
	default 0
	range 0 2
	---help---
		0 100 %, 1 50 %, 2 75 % of the full threshold.

config MOTOR_DRV8145_TOCP
	int "Overcurrent filter (TOCP_SEL, 0-3)"
	default 0
	range 0 3
	---help---
		0 6, 1 3, 2 1.5 us, 3 the minimum (about 0.2 us).

config MOTOR_DRV8145_VMOV
	int "VM overvoltage threshold (VMOV_SEL, 0-3)"
	default 0
	range 0 3
	---help---
		0 35 V, 1 28 V, 2 18 V, 3 off.

config MOTOR_DRV8145_LOAD_VM
	bool "Load to VM (driven by the low side)"
	default n
	---help---
		S_DIAG load type.  A load to GND keeps IPROPI and ITRIP; a load
		to VM keeps active open load detection instead.

config MOTOR_DRV8145_OLP
	bool "Off-state diagnostics (OLP)"
	default n

config MOTOR_DRV8145_OLA
	bool "Open load detection while active (EN_OLA)"
	default n

config MOTOR_DRV8145_SSC
	bool "Spread spectrum clocking"
	default n

config MOTOR_DRV8145_OCP_RETRY
	bool "Retry after overcurrent (else latch)"
	default n

config MOTOR_DRV8145_TSD_RETRY
	bool "Retry after overtemperature (else latch)"
	default n

config MOTOR_DRV8145_VMOV_RETRY
	bool "Retry after VM over- or undervoltage (else latch)"
	default n

config MOTOR_DRV8145_OLA_RETRY
	bool "Retry after an active open load (else latch)"
	default n

endmenu # Default configuration

endif # MOTOR_DRV8145

source "drivers/motor/foc/Kconfig"

endif # MOTOR

menuconfig STEPPER
	bool "Stepper control drivers"
	default n

if STEPPER

config STEPPER_UPPER
	bool "Stepper Motor Generic upper-half driver"
	default n
	---help---
		Enables building of a stepper generic upper half driver.

config STEPPER_A4988
	bool "A4988 Stepper Motor Driver"
	default n
	---help---
		Enables A4988 stepper driver.

config STEPPER_DRV8825
	bool "DRV8825 Stepper Motor Driver"
	default n
	---help---
		Enables DRV8825 stepper driver.

endif # STEPPER
